# One LLM provider is enough. Leave all empty to run the extractive fallback
# (pipeline still works end-to-end; summaries will be weaker).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Alternative: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

POLL_SECONDS=45
LOOKBACK_DAYS=120
HOST=0.0.0.0
PORT=8000
DATA_DIR=data
WATCHLIST=watchlist.yaml
